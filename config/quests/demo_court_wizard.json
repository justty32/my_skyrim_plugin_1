{
  "id": "demo_court_wizard",
  "title": "Court Wizard — Phase 0 demo",
  "version": 1,
  "vars": { "delivered": false },
  "objectives": {
    "lift_curse": { "text": "Cast a spell on the cursed servant to lift the curse", "state": "inactive" }
  },
  "on_start": [
    { "show_message": "(You are now Whiterun's guest Court Wizard. Await the Jarl's summons.)" },
    { "schedule": { "after_hours": 48, "key": "wr_summon" } }
  ],
  "triggers": [
    { "on": "timer", "key": "wr_summon",
      "when": { "var_eq": { "var": "delivered", "value": false } },
      "do": [
        { "show_message": "A letter has arrived from Dragonsreach." },
        { "set_var": { "var": "delivered", "value": true } },
        { "start_dialogue": "court_brief" }
      ] },

    { "on": "spell_cast_on", "character": "victim",
      "when": { "objective_state": { "objective": "lift_curse", "state": "active" } },
      "do": [ { "complete_objective": "lift_curse" } ] },

    { "on": "objective_completed", "objective": "lift_curse",
      "do": [ { "start_dialogue": "thanks" } ] }
  ],
  "dialogues": {
    "court_brief": {
      "entry": "n0",
      "nodes": {
        "n0": {
          "speaker": "Jarl Balgruuf",
          "lines": [ "Court Wizard, a servant of my household is afflicted by a curse no healer can mend.", "Can you lift this affliction?" ],
          "choices": [
            { "text": "Let me see the servant.",
              "then": [
                { "spawn_character": { "name": "Cursed Servant" } },
                { "set_objective_active": "lift_curse" }
              ],
              "goto": "n1" },
            { "text": "I must decline.", "end": true }
          ]
        },
        "n1": { "speaker": "Jarl Balgruuf", "lines": [ "Good. She waits in the side hall — go to her at once." ], "end": true }
      }
    },
    "thanks": {
      "entry": "m0",
      "nodes": {
        "m0": {
          "speaker": "Jarl Balgruuf",
          "lines": [ "The curse is lifted! Whiterun thanks you for your aid." ],
          "choices": [
            { "text": "Think nothing of it.",
              "then": [
                { "give_gold": { "amount": 500 } },
                { "add_var": { "var": "global.whiterun_tasks_done", "value": 1 } },
                { "reset_quest": true }
              ],
              "end": true }
          ]
        }
      }
    }
  }
}
